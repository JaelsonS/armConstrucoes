# URL público do site (usado em SEO / Open Graph após o deploy)
# Exemplo Vercel: https://arm-construcoes.vercel.app
VITE_SITE_URL=https://arm-construcoes.vercel.app

# Web3Forms — criar em https://app.web3forms.com (Access Key pública)
# Contactos, orçamentos e candidaturas são enviados para o email associado à chave
VITE_WEB3FORMS_ACCESS_KEY=your-access-key-here
